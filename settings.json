{
  "// ndu-dark Settings v1.2.0  —  Liquid Glass": "",
  "workbench.colorTheme": "ndu-dark",
  "workbench.iconTheme": "Material Icon Theme",
  "workbench.productIconTheme": "Fluent Icons",
  "editor.fontFamily": "IBM Plex Mono",
  "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
  "editor.lineHeight": 1.8,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "editor.minimap.showSlider": "always",

  "// ─── Liquid Glass · real window blur (Custom UI Style patches Electron) ───": "",
  "// macOS 12+: 'vibrancy' blurs the desktop/wallpaper behind the whole window.": "",
  "// Windows 11 22H2+: delete 'vibrancy'/'visualEffectState', use the two commented keys.": "",
  "// Linux: compositor-dependent — 'transparent': true only, blur needs a WM like KWin/Picom.": "",
  "// Run  >Custom UI Style: Reload  after changing this block.": "",
  "// Windows 11 key 1  →  backgroundMaterial: acrylic": "",
  "// Windows 11 key 2  →  transparent: true": "",
  "custom-ui-style.electron": {
    "vibrancy": "under-window",
    "visualEffectState": "active",
    "backgroundColor": "#00000000"
  },

  "// ─── Liquid Glass · translucent surfaces so the blur shows through ───": "",
  "// Scoped to [ndu-dark]; raise the last two hex digits (alpha) for more opacity.": "",
  "workbench.colorCustomizations": {
    "[ndu-dark]": {
      "editor.background": "#161619e6",
      "editorGutter.background": "#00000000",
      "editorStickyScroll.background": "#161619f2",
      "sideBar.background": "#1212168c",
      "sideBarSectionHeader.background": "#00000000",
      "sideBarStickyScroll.background": "#12121699",
      "activityBar.background": "#00000000",
      "panel.background": "#181a1d99",
      "panelSectionHeader.background": "#00000000",
      "terminal.background": "#12121600",
      "titleBar.activeBackground": "#12121673",
      "titleBar.inactiveBackground": "#12121659",
      "statusBar.background": "#12121673",
      "statusBar.noFolderBackground": "#12121673",
      "statusBar.debuggingBackground": "#c7743bcc",
      "editorGroupHeader.tabsBackground": "#00000000",
      "editorGroupHeader.noTabsBackground": "#00000000",
      "tab.activeBackground": "#1e1f24cc",
      "tab.inactiveBackground": "#00000000",
      "tab.hoverBackground": "#2a2b31b3",
      "tab.unfocusedActiveBackground": "#1e1f2499",
      "breadcrumb.background": "#00000000",
      "editorWidget.background": "#181a1de6",
      "editorHoverWidget.background": "#181a1de6",
      "editorSuggestWidget.background": "#181a1de6",
      "debugToolBar.background": "#181a1de6",
      "peekViewEditor.background": "#161619f2",
      "peekViewResult.background": "#12121699",
      "quickInput.background": "#181a1dbf",
      "quickInputList.focusBackground": "#548af726",
      "menu.background": "#181a1de6",
      "dropdown.background": "#181a1de6",
      "notifications.background": "#181a1de6",
      "notificationCenterHeader.background": "#12121699",
      "input.background": "#0e0e11b3",
      "minimap.background": "#00000000",
      "scrollbar.shadow": "#00000000"
    }
  },

  "custom-ui-style.stylesheet": {
